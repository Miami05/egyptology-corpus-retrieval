# The Whyptology service: Streamlit on 127.0.0.1:8502, a systemd USER unit of `ledio`.
#
# Reconstructed from DEPLOYMENT.md, not copied from the box (audit A46). Every line
# that had to be guessed is marked `# GUESSED:` — diff this file against
# ~/.config/systemd/user/egyptology.service and reconcile before installing it
# (INSTALL_UNITS=1 ~/egyptology-deploy.sh). Settings that carry secrets or differ per
# host live in /home/ledio/egyptology.env, which overrides the Environment= lines here.

[Unit]
Description=Whyptology (Streamlit, 127.0.0.1:8502)
# Runs once the unit has really failed, i.e. after Restart= gave up (default: 5 starts
# in 10 s). It does NOT fire for a single crash that Restart=on-failure recovers, nor
# for a Tailscale/Funnel outage; an external uptime check covers those (DEPLOYMENT.md).
OnFailure=egyptology-notify@%n.service
# GUESSED: no After=/Wants= lines. A user unit cannot order itself on network-online.target.

[Service]
Type=simple
WorkingDirectory=/home/ledio/egyptology
EnvironmentFile=/home/ledio/egyptology.env
# Documented as "in the unit" in DEPLOYMENT.md; egyptology.env wins if it repeats them.
Environment=PRIVATE_DATA_DIR=/home/ledio/egyptology-private
Environment=ANNOTATIONS_DURABLE=1
Environment=WARM_STAGE_RESOURCES=1
# A40: never reload modules when files change underneath the running process (a deploy
# rewrites the tree; a reload would build a second ~3 GB resource set).
Environment=STREAMLIT_SERVER_FILE_WATCHER_TYPE=none
# GUESSED: the exact ExecStart flags and the `python -m streamlit` form.
ExecStart=/home/ledio/venvs/egyptology/bin/python -m streamlit run app/ui/whyptology_app.py --server.address 127.0.0.1 --server.port 8502 --server.headless true
# Warms the stage resource sets with one real paste (scripts/warm_streamlit.py). The
# leading dash: a failed warm-up must never mark the app failed. The deploy script runs
# the same check strictly and rolls back on failure.
# GUESSED: --timeout 500 (it has to stay below TimeoutStartSec).
ExecStartPost=-/home/ledio/venvs/egyptology/bin/python /home/ledio/bin/warm_streamlit.py --url http://127.0.0.1:8502 --timeout 500 --query "𓆓𓂧 𓆑𓆓𓂧 𓀀 𓈖 𓏏𓈖𓏼 𓂋𓍿 𓀀 𓏼𓎟𓏏"
# GUESSED: Restart=on-failure is documented; RestartSec is not set (systemd's 100 ms default).
Restart=on-failure
# systemd's default 90 s is shorter than the corpus load plus the warm-up and would kill
# a healthy service in a loop.
TimeoutStartSec=600
# GUESSED: MemoryMax=6G. Measured peak is 3.0 GB, +1.0 GB for a keyed session and +0.5 GB
# for Similar text (about 4.5 GB worst case). This kills the app at the limit instead of
# letting it starve Vaultwarden and Nextcloud on the same box. Needs memory delegation to
# the user manager: check `systemctl --user show egyptology -p MemoryMax`.
MemoryMax=6G

[Install]
WantedBy=default.target
