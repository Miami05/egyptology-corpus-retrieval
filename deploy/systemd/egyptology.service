# The Whyptology service: Streamlit on 127.0.0.1:8502, a systemd USER unit of `ledio`.
#
# COPIED FROM THE BOX ON 2026-10-26 (`cat ~/.config/systemd/user/egyptology.service` over
# ssh, read-only). This file equals the installed unit directive for directive: only
# comments differ (this header and the commented-out block at the end). Audit A46's
# guess markers are all gone: nothing in this file is reconstructed any more.
#
# NOT INSTALLED YET. Three settings in this unit are real, wanted changes that the box has
# never run: OnFailure=egyptology-notify@%n.service (A42),
# Environment=STREAMLIT_SERVER_FILE_WATCHER_TYPE=none (A40) and MemoryMax=6G. With the
# backup unit's EnvironmentFile= line they are the four pending settings DEPLOYMENT.md
# lists. They are kept below as a commented-out block rather than dropped, so the next
# `INSTALL_UNITS=1 ~/egyptology-deploy.sh` is a deliberate decision and not a silent one.
# The block also spells out Type=simple, the default for this unit, as documentation.
#
# Settings that carry secrets or differ per host live in /home/ledio/egyptology.env,
# which overrides the Environment= lines here.

[Unit]
Description=Whyptology - Egyptology corpus retrieval (Streamlit, port 8502)
After=network-online.target

[Service]
WorkingDirectory=/home/ledio/egyptology
Environment=PYTHONUNBUFFERED=1
Environment=PRIVATE_DATA_DIR=/home/ledio/egyptology-private
Environment=ANNOTATIONS_DURABLE=1
# Build every language stage's resources during the first script run instead of
# leaving them to the first visitor. Costs ~1.9 GB resident of this box's 23 GB;
# a 1 GB host must leave this unset. Read by warm_stage_resources() in
# app/ui/whyptology_app.py.
Environment=WARM_STAGE_RESOURCES=1
EnvironmentFile=-/home/ledio/egyptology.env
ExecStart=/home/ledio/venvs/egyptology/bin/streamlit run app/ui/whyptology_app.py --server.port 8502 --server.address 127.0.0.1 --server.headless true --browser.gatherUsageStats false
# Streamlit runs the script only when a client opens a session, so the env var
# above warms nothing on its own — something has to connect. This opens one real
# session over the websocket and runs expert paste query 1 (PASTE_001) through
# the app's own ?q= shared-search link, which is the exact path a visitor takes:
# stage inference over all three stages, then retrieval. By the time it returns,
# the ~60 s cold build is done and cached for every later session.
# Leading `-`: a warm-up is an optimisation and must never be the reason the app
# is marked failed. If it does not run, the first visitor simply waits as before.
ExecStartPost=-/home/ledio/venvs/egyptology/bin/python /home/ledio/bin/warm_streamlit.py --url http://127.0.0.1:8502 --timeout 420 --query "𓆓𓂧 𓆑𓆓𓂧 𓀀 𓈖 𓏏𓈖𓏼 𓂋𓍿 𓀀 𓏼𓎟𓏏"
# systemd waits for ExecStartPost before calling the unit started, and the default
# 90 s is shorter than the corpus load plus the warm-up. Must stay above the
# --timeout above.
TimeoutStartSec=600
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target

# ---------------------------------------------------------------------------
# NOT INSTALLED — deliberate future change, not a dropped line
# ---------------------------------------------------------------------------
# Move each line up into its section and re-run INSTALL_UNITS=1 to adopt it.
#
# [Unit]
# Runs once the unit has really failed, i.e. after Restart= gave up (default: 5 starts
# in 10 s). It does NOT fire for a single crash that Restart=on-failure recovers, nor
# for a Tailscale/Funnel outage; an external uptime check covers those (DEPLOYMENT.md).
# Needs egyptology-notify@.service installed and NTFY_TOPIC set in egyptology.env.
# OnFailure=egyptology-notify@%n.service
#
# [Service]
# The unit's type is already simple by default; spelling it out is documentation.
# Type=simple
# A40: never reload modules when files change underneath the running process (a deploy
# rewrites the tree; a reload would build a second ~3 GB resource set).
# Environment=STREAMLIT_SERVER_FILE_WATCHER_TYPE=none
# Measured peak is 3.0 GB, +1.0 GB for a keyed session and +0.5 GB for Similar text
# (about 4.5 GB worst case). This kills the app at the limit instead of letting it
# starve Vaultwarden and Nextcloud on the same box. Needs memory delegation to the
# user manager: check `systemctl --user show egyptology -p MemoryMax`.
# MemoryMax=6G
