# The nightly database backup (scripts/backup_db.sh), started by egyptology-backup.timer.
#
# COPIED FROM THE BOX ON 2026-10-26 (read-only ssh). Equals the installed unit once the
# commented-out block at the end is left out. The audit A46 guess markers are gone.
#
# NOT INSTALLED YET, kept below rather than dropped: OnFailure=egyptology-notify@%n.service
# (A42) and EnvironmentFile=-/home/ledio/egyptology.env. The second one matters more than
# it looks — without it the backup job never sees DATABASE_URL, HEALTHCHECK_URL or
# OFFSITE_PRUNE from egyptology.env, so on the box today the script falls back to
# /home/ledio/egyptology/egyptology.db and sends no healthchecks.io heartbeat.

[Unit]
Description=Snapshot egyptology.db into egyptology-backups (30-day retention)
Documentation=file:///home/ledio/egyptology/DEPLOYMENT.md

[Service]
Type=oneshot
# The repo is the canonical copy; /home/ledio/bin is refreshed from it by
# egyptology-deploy.sh, so the job keeps working during a failed deploy.
ExecStart=/home/ledio/bin/backup_db.sh
# Empty = on-box only. Fill in an rsync destination to get the snapshot off
# this disk; the script reports which of the two it did.
Environment=OFFSITE_TARGET=b2:egyptology-backups-ledio
Environment=RETENTION_DAYS=30

