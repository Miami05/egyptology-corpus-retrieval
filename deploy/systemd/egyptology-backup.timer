# Fires egyptology-backup.service every night at 03:30, with up to 5 minutes of jitter.
#
# COPIED FROM THE BOX ON 2026-10-26 (read-only ssh). Equals the installed unit; the
# audit A46 guess marker on RandomizedDelaySec is gone — the spelling was right.
# Nothing in this file is pending installation.

[Unit]
Description=Nightly egyptology.db backup at 03:30

[Timer]
OnCalendar=*-*-* 03:30:00
# The box is not always awake at 03:30; catch up on the next boot instead of
# silently skipping a night.
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
