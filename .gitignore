# Downloaded source corpora — reproducible via scripts/download_all_sources.py,
# and data/raw/aes is a 600MB embedded git clone that must not be committed.
data/raw/aes/
data/raw/tla_earlier/
data/raw/tla_late/
data/raw/tla_demotic/

data/raw/bbaw_egyptian/
data/raw/helsinki_lexicon/
data/raw/ramses/
data/raw/standrews/

# Importer side outputs; the corpus itself is examples.csv
data/processed/bbaw_rows.csv

# Non-commercial corpus (the St Andrews texts): CC BY-SA is share-alike and cannot
# carry NC material, so it never enters examples.csv or the public repository. (Ramses
# is not private any more: it is in examples.csv under a CC BY-SA grant, see
# DATA-LICENSE.md.) Loaded at runtime from PRIVATE_DATA_DIR (default data/private/); see
# app/data/loader.py:load_private_examples and DATA-LICENSE.md.
data/private/

# Personal and employer exports (ChatGPT export, work files) must never reach this
# public repository, and `git add .` would take everything under 100 MB. Keep such
# folders outside the project; these rules are only a guard.
extracted-data-*/
extracted-data-*.zip
outputs/
